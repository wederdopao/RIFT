  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.9.0",
    "aedes": "^0.51.3",
    "esbuild": "^0.24.0",
    "playwright-core": "^1.48.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "websocket-stream": "^5.5.2"
  },
  "dependencies": {
    "@piltoverarchive/riftbound-deck-codes": "^1.5.0",
    "mqtt": "^5.10.1"
  }
