diff --git a/tests/unl-revisao-fury.test.ts b/tests/unl-revisao-fury.test.ts
index bdd7bcb..4588cf7 100644
--- a/tests/unl-revisao-fury.test.ts
+++ b/tests/unl-revisao-fury.test.ts
@@ -57,3 +57,41 @@ test('Red Brambleback: segurar com Skyfall não dobra a habilidade de conquista
   s.e.runSync(s.e.settle());
   assert.equal(count(s, /Resolve: Inviolus Vox/g), 1, s.log(60));
